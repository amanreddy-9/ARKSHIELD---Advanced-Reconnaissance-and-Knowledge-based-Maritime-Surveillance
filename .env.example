# ARKSHIELD System Environment Configuration
# Copy this file to .env and configure your credentials

# Groq Vision-Language Model API
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BRIEFING_MAX_TOKENS=250
GROQ_CHAT_MAX_TOKENS=300
GROQ_CLASSIFY_MAX_TOKENS=120

# Groq Request Protection & Rate Limiting
GROQ_MIN_INTERVAL_SECONDS=10
GROQ_TRACK_RETRY_SECONDS=60
GROQ_LOCAL_TOKEN_BUDGET=180000
GROQ_CACHE_TTL_SECONDS=3600

# Model Paths & Detection Parameters
VHRV_MODEL_PATH=models/weights/vhrv_best.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.60

# Device Configuration ('auto', 'cuda', 'mps', 'cpu')
COMPUTE_DEVICE=auto
